# ==========================================
# Database Configuration (PostgreSQL + PGVector)
# ==========================================
POSTGRES_DB=resume_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Backend Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/resume_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# ==========================================
# AI & Embedding Model Configuration
# ==========================================
# Options: 'hybrid' (deterministic fallback + OpenAI), 'local', or 'openai'
AI_PROVIDER=hybrid
OPENAI_API_KEY=your_openai_api_key_here
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4o-mini

# ==========================================
# CORS Configuration
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_BASE_URL=http://localhost:8080
