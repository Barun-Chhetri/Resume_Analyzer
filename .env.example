# ==========================================
# Database Configuration (PostgreSQL + PGVector)
# ==========================================
POSTGRES_DB=barun_db
POSTGRES_USER=barun
POSTGRES_PASSWORD=barun123
POSTGRES_PORT=5432

# Backend Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/barun_db
SPRING_DATASOURCE_USERNAME=barun
SPRING_DATASOURCE_PASSWORD=barun123

# ==========================================
# AI & Embedding Model Configuration
# ==========================================
# Options: 'hybrid' (deterministic fallback + OpenAI), 'local', or 'openai'
AI_PROVIDER=hybrid
OPENAI_API_KEY=your-openai-api-key-here
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4o-mini

# ==========================================
# CORS Configuration
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
